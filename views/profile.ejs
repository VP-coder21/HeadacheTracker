<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Headache Tracker Profile</title>
    <style>
        .center {
            margin: auto;
             text-align: center;
             font-size: 100%;
        }
        ul {
            list-style-type: none;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #333;
        }

        li {
            width:calc(25% - 0.75px);
            float: left;
            border-right: 1px solid #bbb;
            font-size: large;
        }

        li:last-child {
            border-right: none;
        }

        li a {
            display: block;
            color: white;
            text-align: center;
            padding: 14px 16px;
            text-decoration: none;
        }

        li a:hover:not(.active) {
        background-color: #111;
        }

        .active {
            background-color: #04AA6D;
        }

        .buttonLayout {
            padding: 5px;
            font-size: medium;
            margin-block: 10px;
        }

        .leftSide {
            margin: auto;
            width: 20%;
            text-align: left;
        }

        .smallBottomPadding {
            margin-bottom: 5px;
        }
    </style>
</head>
<body>
    <!--Navigation Bar-->
    <ul>
        <li><a href="/homepage">Home</a></li>
        <li><a href="/analyze">Analyze</a></li>
        <li><a href="/calender">Calender</a></li>
        <li><a class = "active" href="/profile">Profile</a></li>
    </ul>
    <div class = "center"> 
        <img src="assets/PlaceholderImage.png" alt="Profile Picture" width="250" height="250"></img>
        <h2>Username: </h2>
        <h2>Password: </h2>
        <form method="post" class="leftSide" action="/profile">
            <h2 class="smallBottomPadding" >Color Theme:</h2>
            <input type ="radio" name="color_theme" id="light"  value="light">
            <label for="light">Light</label><br>
            <input type ="radio" name="color_theme" id="dark" value="dark">
            <label for="dark">Dark</label><br>
            <input type ="radio" checked name="color_theme" id="systemDefault" value="systemDefault">
            <label for="systemDefault">Sytsem Default</label><br>
            
            <input type ="submit" value="Save Changes"></input>
        </form>
    
        <button class = "buttonLayout">Terms and Conditions</button>
        <hr>
        <form action="/logout?_method=delete" method="post">
            <button class= "buttonLayout" type="submit">Logout</button>
        </form>
        <button class= "buttonLayout">Delete Account</button>
    </div>
</body>
</html>