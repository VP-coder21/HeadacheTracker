<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Headache Tracker Homepage</title>
    <style>
        .center {
            margin: auto;
             text-align: center;
             font-size: 100%;
        }
        ul {
            list-style-type: none;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #333;
        }

        li {
            width:calc(25% - 0.75px);
            float: left;
            border-right: 1px solid #bbb;
            font-size: large;
        }

        li:last-child {
            border-right: none;
        }

        li a {
            display: block;
            color: white;
            text-align: center;
            padding: 14px 16px;
            text-decoration: none;
        }

        li a:hover:not(.active) {
            background-color: #111;
        }

        .active {
            background-color: #04AA6D;
        }
        
        .buttonLayout{
            position: absolute; 
            bottom: 5%; left: 50%; 
            transform: translateX(-50%); 
            font-size: 2.5em;
            border: 4px, solid, #111;
            background-color: #bbb;
            border-radius: 10px;
        }

        button a {
            display: block;
            color: white;
            text-align: center;
            padding: 14px 16px;
            text-decoration: none;
        }

        button:hover{
            background-color: #111;
        }

        th, td {
            border:1px solid black;
        }

        .overflowBoxLayout{
            height: 50%;
            width: 75%;
            margin: auto;
            border: 2px, solid, black;
            font-size: medium;
            overflow: auto;
            background-color:lightgray;
            scrollbar-width: 5%;
            scrollbar-base-color: darkgray;
        }
    </style>
</head>
<body>
    <!--Navigation Bar-->
    <ul>
        <li><a  class = "active" href="/homepage">Home</a></li>
        <li><a href="/analyze">Analyze</a></li>
        <li><a href="/calender">Calender</a></li>
        <li><a href="/profile">Profile</a></li>
    </ul>
    <div class = "center"> 
        <h1 style="padding-top: 20px">Hello, <%= name %></h1>
        <h1 style="font-size:2.5em; padding-top: 20px;">Recent Headaches</h1>
        <table class="overflowBoxLayout">
            <tr>
                <th>Length</th>
                <th>Severity</th>
                <th>Date</th>
            </tr>
        </table>
        <button class="buttonLayout"> <a href="/homepage/record">Record Headaches</a></button>
    </div>
</body>
</html>